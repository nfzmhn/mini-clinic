    {
      "name": "Dashboard",
      "item": [
        {
          "name": "GET /dashboard",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": { "raw": "{{base_url}}/dashboard", "host": ["{{base_url}}"], "path": ["dashboard"] },
            "description": "Statistik ringkasan: total pasien, registrasi hari ini, antrian pending, jumlah poli."
          }
        }
      ]
    }
  ]
}
