generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  DOCTOR
  REGISTRATION_OFFICER
}

enum Gender {
  L
  P
}

enum RegistrationStatus {
  Menunggu
  CheckIn
  Pemeriksaan
  Selesai
}

enum PaymentType {
  BPJS
  UMUM
  ASURANSI
}

model User {
  id            Int            @id @default(autoincrement())
  username      String         @unique
  passwordHash  String
  role          Role
  poliId        Int?
  poli          Poli?          @relation(fields: [poliId], references: [id])
  registrations Registration[] @relation("DoctorRegistrations")
  medicalRecords MedicalRecord[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("users")
}

model Poli {
  id            Int            @id @default(autoincrement())
  name          String         @unique
  code          String         @unique
  users         User[]
  registrations Registration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@map("polis")
}

model Patient {
  id             Int             @id @default(autoincrement())
  mrn            String          @unique // RM-0001
  nik            String          @unique
  name           String
  gender         Gender
  birthDate      DateTime
  phone          String
  address        String          @db.Text
  registrations  Registration[]
  medicalRecords MedicalRecord[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("patients")
}

model Registration {
  id             Int                @id @default(autoincrement())
  patientId      Int
  patient        Patient            @relation(fields: [patientId], references: [id])
  doctorId       Int
  doctor         User               @relation("DoctorRegistrations", fields: [doctorId], references: [id])
  poliId         Int
  poli           Poli               @relation(fields: [poliId], references: [id])
  visitDate      DateTime           @default(now())
  paymentType    PaymentType
  complaint      String             @db.Text
  status         RegistrationStatus @default(Menunggu)
  queueNumber    String             // A001
  medicalRecord  MedicalRecord?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@map("registrations")
}

model MedicalRecord {
  id             Int               @id @default(autoincrement())
  registrationId Int               @unique
  registration   Registration      @relation(fields: [registrationId], references: [id])
  patientId      Int
  patient        Patient           @relation(fields: [patientId], references: [id])
  doctorId       Int
  doctor         User              @relation(fields: [doctorId], references: [id])
  subjective     String            @db.Text
  bp             String            // Blood Pressure
  temp           Float
  weight         Float
  height         Float
  diagnosis      String            @db.Text
  therapy        String            @db.Text
  actions        MedicalAction[]
  prescription   Prescription?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("medical_records")
}

model MedicalAction {
  id              Int           @id @default(autoincrement())
  medicalRecordId Int
  medicalRecord   MedicalRecord @relation(fields: [medicalRecordId], references: [id])
  name            String
  cost            Decimal       @db.Decimal(10, 2)
  createdAt       DateTime      @default(now())

  @@map("medical_actions")
}

model Prescription {
  id              Int                @id @default(autoincrement())
  medicalRecordId Int                @unique
  medicalRecord   MedicalRecord      @relation(fields: [medicalRecordId], references: [id])
  notes           String?            @db.Text
  items           PrescriptionItem[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@map("prescriptions")
}

model PrescriptionItem {
  id             Int          @id @default(autoincrement())
  prescriptionId Int
  prescription   Prescription @relation(fields: [prescriptionId], references: [id])
  medicine       String
  dosage         String
  qty            Int
  instruction    String
  createdAt      DateTime     @default(now())

  @@map("prescription_items")
}
